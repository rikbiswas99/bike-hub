# Copy this file to ".env" and change the values.
APP_NAME=BIKE-HUB API
DEBUG=True

# postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/bikehub

# Used later for login tokens (JWT). Make it long and random.
SECRET_KEY=change-this-to-a-long-random-text
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Websites allowed to call this API (separate with commas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
